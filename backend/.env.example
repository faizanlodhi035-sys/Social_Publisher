# ==============================================================================
# Social Publisher Backend - Environment Configuration
# ==============================================================================
# Note: Keep this file secure and NEVER commit the actual '.env' to version control.
# In production, inject these variables via Google Cloud Secret Manager / Cloud Run.
# ==============================================================================

PORT=4000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000
NODE_ENV=development

# Allowed CORS origins (comma-separated list for multi-domain production setups)
ALLOWED_ORIGINS=https://socialpublisher.web.app,https://socialpublisher.firebaseapp.com

# Session & Token Protection Secrets (Must be 32+ char cryptographic random strings in production)
SESSION_SECRET=dev_social_publisher_session_secret_key_12345
ENCRYPTION_SECRET=dev_aes_encryption_secret_key_1234567890
WORKER_SECRET=dev_social_publisher_session_secret_key_12345

# ==============================================================================
# Firebase Admin SDK Credentials (Private - Server Only)
# In Cloud Run / Google Cloud environments, default application credentials (ADC)
# are automatically discovered. If deploying outside GCP, provide the service account:
# ==============================================================================
FIREBASE_PROJECT_ID=social-publisher-dev
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=social-publisher-dev.appspot.com

# Optional local Firebase Emulators
# FIRESTORE_EMULATOR_HOST=localhost:8080
# FIREBASE_STORAGE_EMULATOR_HOST=localhost:9199

# ==============================================================================
# Google Cloud Tasks Configuration (Background Scheduling & Retries)
# ==============================================================================
GCP_PROJECT_ID=
GCP_TASKS_LOCATION=us-central1
GCP_TASKS_QUEUE_NAME=social-publisher-publishing-queue

# ==============================================================================
# Google Gemini AI Configuration (Private - Server Only, Never expose to frontend)
# ==============================================================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_TIMEOUT_MS=25000
# AI_PROVIDER=gemini # Options: "gemini" (production) or "mock" (offline test simulation)

# ==============================================================================
# Webhook Verification Secret
# ==============================================================================
WEBHOOK_VERIFY_TOKEN=social_publisher_webhook_secret_verify_token

# ==============================================================================
# Social Provider OAuth Credentials (Server-Side Only)
# ==============================================================================

# Meta API (Facebook & Instagram Graph API)
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:4000/api/auth/facebook/callback

# TikTok API
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:4000/api/auth/tiktok/callback

# Google / YouTube API
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/youtube/callback
