# ==============================================================================
# Social Publisher - Frontend Client Environment Configuration
# ==============================================================================
# NOTE: Variables prefixed with 'VITE_' are bundled into the public browser build.
# NEVER place Gemini API keys, OAuth client secrets, or private keys in this file.
# Server secrets must be configured in 'backend/.env' exclusively.
# ==============================================================================

# Backend API Endpoint
# In production, set to your backend Cloud Run / Cloud Function URL or leave empty for same-origin proxy
VITE_API_BASE_URL=http://localhost:4000/api

# Public Firebase Web Client Configuration (Safe for browser exposure)
VITE_FIREBASE_API_KEY=your_firebase_web_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=social-publisher-dev.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=social-publisher-dev
VITE_FIREBASE_STORAGE_BUCKET=social-publisher-dev.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456
